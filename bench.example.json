{
  "data_dir": "./data",
  "repos": {
    "waymark": {
      "clone_url": "https://github.com/ckopsa/waymark",
      "default_branch": "main",
      "deny": ["*.pem", "*.key", ".env*", "**/secrets/**"],
      "check": {"command": "cd workqueue10 && clojure -M:check"}
    },
    "ckopsa/waymark-bench": {
      "clone_url": "https://github.com/ckopsa/waymark-bench",
      "default_branch": "main",
      "test": {"workflow": "tests.yml", "input": "only",
               "select_pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)+$"}
    }
  }
}
