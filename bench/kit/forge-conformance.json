{
  "cases": [
    {"name": "a skipped required check reads green",
     "asks": "verdict", "forge": "github", "required": ["gate"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "skipped"}],
     "expect": {"verdict": "green"}},
    {"name": "a neutral required check reads green",
     "asks": "verdict", "forge": "github", "required": ["gate"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "neutral"}],
     "expect": {"verdict": "green"}},
    {"name": "a timed out required check is red",
     "asks": "verdict", "forge": "github", "required": ["gate"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "timed_out"}],
     "expect": {"verdict": "red", "names": ["gate"]}},
    {"name": "a cancelled required check is interrupted",
     "asks": "verdict", "forge": "github", "required": ["gate"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "cancelled"}],
     "expect": {"verdict": "interrupted", "names": ["gate"]}},
    {"name": "a stale required check is interrupted",
     "asks": "verdict", "forge": "github", "required": ["gate"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "stale"}],
     "expect": {"verdict": "interrupted", "names": ["gate"]}},
    {"name": "a red check beside an interrupted one is red",
     "asks": "verdict", "forge": "github", "required": ["a", "b"],
     "checks": [{"check_name": "a", "status": "completed", "conclusion": "failure"},
                {"check_name": "b", "status": "completed", "conclusion": "cancelled"}],
     "expect": {"verdict": "red", "names": ["a"]}},
    {"name": "a running required check has no verdict",
     "asks": "verdict", "forge": "github", "required": ["a", "b"],
     "checks": [{"check_name": "a", "status": "completed", "conclusion": "failure"},
                {"check_name": "b", "status": "in_progress"}],
     "expect": null},
    {"name": "a required check with no run has no verdict",
     "asks": "verdict", "forge": "github", "required": ["a", "b"],
     "checks": [{"check_name": "a", "status": "completed", "conclusion": "success"}],
     "expect": null},
    {"name": "a STOPPED build is interrupted, not red and not green",
     "asks": "state", "forge": "bitbucket",
     "check": {"check_name": "build", "state": "STOPPED"},
     "expect": "interrupted"},
    {"name": "a STOPPED required build makes the head interrupted",
     "asks": "verdict", "forge": "bitbucket", "required": ["build"],
     "checks": [{"check_name": "build", "state": "STOPPED"}],
     "expect": {"verdict": "interrupted", "names": ["build"]}},
    {"name": "a STOPPED rerun of a FAILED build is not a recovery",
     "asks": "verdict", "forge": "bitbucket", "required": ["build"],
     "checks": [{"check_name": "build", "id": 1, "state": "FAILED"},
                {"check_name": "build", "id": 2, "state": "STOPPED"}],
     "expect": {"verdict": "interrupted", "names": ["build"]}},
    {"name": "an INPROGRESS build has no verdict",
     "asks": "verdict", "forge": "bitbucket", "required": ["build"],
     "checks": [{"check_name": "build", "state": "INPROGRESS"}],
     "expect": null},
    {"name": "a PR 0 behind its base is not behind",
     "asks": "behind", "behind_by": 0,
     "expect": false},
    {"name": "a PR 2 behind its base is behind",
     "asks": "behind", "behind_by": 2,
     "expect": true},
    {"name": "a failed advisory check is red",
     "asks": "verdict", "forge": "github", "required": ["gate"], "advisory": ["wiz"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "success"},
                {"check_name": "wiz", "status": "completed", "conclusion": "failure"}],
     "expect": {"verdict": "red", "names": ["wiz"]}},
    {"name": "a pending advisory check does not hold",
     "asks": "verdict", "forge": "github", "required": ["gate"], "advisory": ["wiz"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "success"},
                {"check_name": "wiz", "status": "in_progress"}],
     "expect": {"verdict": "green"}},
    {"name": "an advisory check with no run does not hold",
     "asks": "verdict", "forge": "github", "required": ["gate"], "advisory": ["wiz"],
     "checks": [{"check_name": "gate", "status": "completed", "conclusion": "success"}],
     "expect": {"verdict": "green"}}
  ]
}
